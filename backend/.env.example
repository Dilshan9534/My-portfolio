PORT=5000

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db
# Set to true when using a hosted MySQL provider (Aiven, RDS, etc.)
DB_SSL=false

# --- CORS ---
# In production set this to your frontend URL, e.g. https://yourname.vercel.app
# Leave blank in dev to allow all origins.
CORS_ORIGIN=

# --- Email notifications when someone books (optional) ---
# NOTE: many free hosts (including Render's free tier) block outbound SMTP
# ports 25/465/587. If mail silently fails in production, use an HTTP email
# API instead (Resend, SendGrid, Brevo) rather than raw SMTP.
OWNER_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com
